#!/usr/bin/env python3
"""ascii-wallpaper — transcode a video into an ASCII-art wallpaper.

Each frame is rendered as a grid of monospace glyphs. Cell color can be
snapped to the current Omarchy theme palette (colors.toml), so the result
always matches your colorscheme.

Deps: ffmpeg, ImageMagick (magick). No Python packages required.

Examples:
  ascii-wallpaper clip.mp4                    # -> clip-ascii.mp4, themed colors
  ascii-wallpaper clip.mp4 --mode mono        # theme fg on bg only
  ascii-wallpaper clip.mp4 --mode source      # keep original colors
  ascii-wallpaper clip.mp4 --ramp blocks --rows 60
  ascii-wallpaper clip.mp4 --preview out.png --seek 5
"""

import argparse
import json
import math
import multiprocessing as mp
import os
import subprocess
import sys
import tomllib

THEME_COLORS = os.path.expanduser(
    "~/.local/state/omarchy/current/theme/colors.toml"
)
DEFAULT_FONT = "/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf"

RAMPS = {
    # light -> dark (increasing ink density)
    "classic": " .:-=+*#%@",
    "detailed": " .'`^\",:;Il!i><~+_-?][}{1)(|/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$",
    "blocks": " ░▒▓█",
    "digits": " 123456789",
    "binary": " 01",
}

# colors.toml keys used as glyph colors in "themed" mode (backgrounds excluded)
PALETTE_KEYS = [
    "accent", "selection", "muted",
    "foreground", "dark_foreground", "light_foreground", "bright_foreground",
    "red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown",
    "bright_red", "bright_yellow", "bright_green",
    "bright_cyan", "bright_blue", "bright_magenta",
]


def die(msg, code=1):
    print(f"ascii-wallpaper: {msg}", file=sys.stderr)
    sys.exit(code)


def run(argv, **kw):
    return subprocess.run(argv, check=True, **kw)


def probe(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0",
         "-show_entries", "stream=width,height,r_frame_rate,duration",
         "-of", "json", path],
        capture_output=True, text=True, check=True).stdout
    st = json.loads(out)["streams"][0]
    num, den = st["r_frame_rate"].split("/")
    fps = float(num) / float(den) if float(den) else 30.0
    return int(st["width"]), int(st["height"]), fps, float(st.get("duration") or 0)


def load_theme():
    try:
        with open(THEME_COLORS, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}


def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def build_palette(mode, theme, bg_hex):
    """Return (palette list of rgb, bg rgb)."""
    bg = hex2rgb(bg_hex) if bg_hex else hex2rgb(theme.get("background", "#000000"))
    if mode == "mono":
        fg = hex2rgb(theme.get("foreground", "#ffffff"))
        return [fg], bg
    if mode == "themed":
        pal = []
        for k in PALETTE_KEYS:
            if k in theme:
                c = hex2rgb(theme[k])
                if c != bg and c not in pal:
                    pal.append(c)
        if not pal:  # no theme found -> grayscale
            pal = [(v, v, v) for v in range(64, 256, 24)]
        return pal, bg
    # source mode: uniform 6x6x6 RGB cube (216 colors); lut is a direct
    # quantizer (index = r6*36 + g6*6 + b6), no nearest-color search needed
    pal = []
    for r6 in range(6):
        for g6 in range(6):
            for b6 in range(6):
                pal.append((r6 * 51, g6 * 51, b6 * 51))
    return pal, bg


def build_lut(palette, source_mode):
    """bytes of len 32768: 5bit r,g,b -> palette index."""
    if source_mode:
        lut = bytearray(32768)
        i = 0
        for r5 in range(32):
            r6 = r5 * 6 // 32
            for g5 in range(32):
                g6 = g5 * 6 // 32
                for b5 in range(32):
                    lut[i] = r6 * 36 + g6 * 6 + b5 * 6 // 32
                    i += 1
        return bytes(lut)
    lut = bytearray(32768)
    pal = palette
    n = len(pal)
    i = 0
    for r5 in range(32):
        r = r5 * 255 // 31
        for g5 in range(32):
            g = g5 * 255 // 31
            for b5 in range(32):
                b = b5 * 255 // 31
                best, bestd = 0, 1 << 62
                for j in range(n):
                    pr, pg, pb = pal[j]
                    d = (r - pr) * (r - pr) + (g - pg) * (g - pg) + (b - pb) * (b - pb)
                    if d < bestd:
                        bestd, best = d, j
                lut[i] = best
                i += 1
    return bytes(lut)


def render_ink_tiles(ramp, cw, ch, pointsize, font):
    """Rasterize each ramp char to a grayscale ink tile (cw*ch bytes, 0-255)."""
    tiles = []
    for c in ramp:
        if c == " ":
            tiles.append(bytes(cw * ch))
            continue
        p = subprocess.run(
            ["magick", "-background", "black", "-fill", "white",
             "-font", font, "-pointsize", str(pointsize),
             f"label:{c}", "-gravity", "center",
             "-extent", f"{cw}x{ch}", "-depth", "8", "gray:-"],
            capture_output=True, check=True)
        if len(p.stdout) != cw * ch:
            die(f"glyph tile for {c!r} has {len(p.stdout)} bytes, expected {cw*ch}")
        tiles.append(p.stdout)
    return tiles


def tint_tiles(ink_tiles, palette, bg, cw, ch):
    """Pre-blend every glyph tile in every palette color -> tuple of row bytes."""
    cell_bytes = cw * ch * 3
    cw3 = cw * 3
    bgr, bgg, bgb = bg
    all_tiles = []
    for (fr, fg, fb) in palette:
        dr, dg, db = fr - bgr, fg - bgg, fb - bgb
        # 256-entry lookup: ink value -> (r,g,b)
        lr = bytes(bgr + (dr * i) // 255 for i in range(256))
        lg = bytes(bgg + (dg * i) // 255 for i in range(256))
        lb = bytes(bgb + (db * i) // 255 for i in range(256))
        for ink in ink_tiles:
            buf = bytearray(cell_bytes)
            for p in range(cw * ch):
                a = ink[p]
                o = p * 3
                buf[o] = lr[a]
                buf[o + 1] = lg[a]
                buf[o + 2] = lb[a]
            all_tiles.append(tuple(
                bytes(buf[y * cw3:(y + 1) * cw3]) for y in range(ch)))
    return all_tiles  # index = pal_idx * nramp + glyph_idx


# ---- multiprocessing worker state ----
_W = {}


def _init_worker(tiles, lut, nramp, cols, rows, cw, ch, out_stride):
    _W.update(tiles=tiles, lut=lut, nramp=nramp, cols=cols, rows=rows,
              cw=cw, ch=ch, stride=out_stride)


def render_frame(cell_frame):
    tiles = _W["tiles"]
    lut = _W["lut"]
    nramp = _W["nramp"]
    cols, rows = _W["cols"], _W["rows"]
    cw, ch, stride = _W["cw"], _W["ch"], _W["stride"]
    cw3 = cw * 3
    inv = (nramp - 1) / 255.0
    out = bytearray(rows * ch * stride)
    for cy in range(rows):
        cell_row = cell_frame[cy * cols * 3:(cy + 1) * cols * 3]
        band = cy * ch * stride
        for cx in range(cols):
            i = cx * 3
            r = cell_row[i]
            g = cell_row[i + 1]
            b = cell_row[i + 2]
            luma = (r * 299 + g * 587 + b * 114) // 1000
            gidx = int(luma * inv)
            pidx = lut[((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)]
            tile = tiles[pidx * nramp + gidx]
            o = band + cx * cw3
            for trow in tile:
                out[o:o + cw3] = trow
                o += stride
    return bytes(out)


def main():
    ap = argparse.ArgumentParser(description="Video -> ASCII-art wallpaper")
    ap.add_argument("input")
    ap.add_argument("-o", "--output")
    ap.add_argument("--mode", choices=["themed", "source", "mono"],
                    default="themed",
                    help="color mode: themed = snap to omarchy palette (default), "
                         "source = keep video colors, mono = theme fg on bg")
    ap.add_argument("--ramp", default="classic",
                    help="ramp name (classic|detailed|blocks|digits|binary) "
                         "or a literal char string, light->dark")
    ap.add_argument("--rows", type=int, default=0,
                    help="text rows (default: ~48 at output height)")
    ap.add_argument("--cell", type=int, default=0,
                    help="cell height in px (overrides --rows); width ~0.55x")
    ap.add_argument("--pointsize", type=int, default=0,
                    help="glyph pointsize (default ~0.8 * cell height)")
    ap.add_argument("--font", default=DEFAULT_FONT)
    ap.add_argument("--fps", type=float, default=30.0, help="max output fps")
    ap.add_argument("--width", type=int, default=0,
                    help="cap output width (keeps aspect)")
    ap.add_argument("--crf", type=int, default=20)
    ap.add_argument("--preset", default="medium")
    ap.add_argument("--bg", default="", help="background hex color override")
    ap.add_argument("--seek", type=float, default=0.0, help="start offset (s)")
    ap.add_argument("--duration", type=float, default=0.0, help="limit seconds")
    ap.add_argument("--preview", metavar="PNG",
                    help="render a single frame to PNG and exit (use with --seek)")
    ap.add_argument("--jobs", type=int, default=max(1, (os.cpu_count() or 4) - 2))
    args = ap.parse_args()

    if not os.path.isfile(args.input):
        die(f"no such file: {args.input}")
    ramp = RAMPS.get(args.ramp, args.ramp)
    if len(ramp) < 2:
        die("ramp needs at least 2 chars")
    if len(set(ramp)) != len(ramp):
        ramp = "".join(dict.fromkeys(ramp))

    iw, ih, ifps, dur = probe(args.input)
    fps = min(args.fps, ifps) if ifps > 0 else args.fps

    # output geometry
    ow = min(args.width, iw) if args.width else iw
    ow -= ow % 2
    oh = max(2, round(ih * ow / iw))
    oh -= oh % 2

    cell_h = args.cell or max(14, round(oh / 48))
    cell_w = max(6, round(cell_h * 0.55))
    rows = args.rows or oh // cell_h
    if args.rows:
        cell_h = max(8, oh // args.rows)
        cell_w = max(6, round(cell_h * 0.55))
    cols = ow // cell_w
    # yuv420p requires even dimensions: drop a cell if the product is odd
    if (cols * cell_w) % 2:
        cols -= 1
    if (rows * cell_h) % 2:
        rows -= 1
    ow, oh = cols * cell_w, rows * cell_h
    pointsize = args.pointsize or max(8, round(cell_h * 0.8))

    theme = load_theme()
    palette, bg = build_palette(args.mode, theme, args.bg)
    source_mode = args.mode == "source"

    lut = build_lut(palette, source_mode)

    print(f"[ascii-wallpaper] {iw}x{ih}@{ifps:.2f} -> {ow}x{oh}@{fps:.2f}  "
          f"grid {cols}x{rows} cells {cell_w}x{cell_h}pt{pointsize}  "
          f"mode={args.mode} palette={len(palette)}", file=sys.stderr)

    sys.stderr.write("[ascii-wallpaper] rasterizing glyphs...\r")
    ink_tiles = render_ink_tiles(ramp, cell_w, cell_h, pointsize, args.font)
    tiles = tint_tiles(ink_tiles, palette, bg, cell_w, cell_h)
    del ink_tiles

    # decoder: cell-res rgb frames
    dec = ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error"]
    if args.seek:
        dec += ["-ss", str(args.seek)]
    dec += ["-i", args.input]
    if args.duration:
        dec += ["-t", str(args.duration)]
    dec += ["-vf", f"fps={fps:.4f},scale={cols}:{rows}:flags=area",
            "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
    decoder = subprocess.Popen(dec, stdout=subprocess.PIPE,
                               bufsize=cols * rows * 3 * 8)

    cell_bytes = cols * rows * 3
    out_w, out_h = ow, oh
    frame_bytes = out_w * out_h * 3

    if args.preview:
        raw = decoder.stdout.read(cell_bytes)
        decoder.kill()
        if len(raw) < cell_bytes:
            die("could not decode a frame at --seek")
        _init_worker(tiles, lut, len(ramp), cols, rows, cell_w, cell_h, out_w * 3)
        frame = render_frame(raw)
        run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
             "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{out_w}x{out_h}",
             "-i", "-", args.preview], input=frame)
        print(args.preview)
        return

    out = args.output
    if not out:
        base = os.path.splitext(args.input)[0]
        out = base + "-ascii.mp4"

    enc = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
           "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{out_w}x{out_h}",
           "-r", f"{fps:.4f}", "-i", "-",
           "-c:v", "libx264", "-preset", args.preset, "-crf", str(args.crf),
           "-pix_fmt", "yuv420p", "-movflags", "+faststart", "-an", out]
    encoder = subprocess.Popen(enc, stdin=subprocess.PIPE)

    eff_dur = dur - args.seek if dur else 0
    if args.duration:
        eff_dur = min(eff_dur, args.duration) if eff_dur else args.duration
    total = int(eff_dur * fps) if eff_dur else 0
    n = 0
    try:
        with mp.Pool(args.jobs, initializer=_init_worker,
                     initargs=(tiles, lut, len(ramp), cols, rows,
                               cell_w, cell_h, out_w * 3)) as pool:
            def frames():
                while True:
                    buf = decoder.stdout.read(cell_bytes)
                    if len(buf) < cell_bytes:
                        return
                    yield buf
            for frame in pool.imap(render_frame, frames(), chunksize=4):
                encoder.stdin.write(frame)
                n += 1
                if n % 30 == 0 or n == total:
                    pct = f" ({n*100//total}%)" if total else ""
                    sys.stderr.write(f"\r[ascii-wallpaper] frame {n}{pct}   ")
                    sys.stderr.flush()
    except BrokenPipeError:
        pass
    finally:
        decoder.stdout.close()
        decoder.wait()
        encoder.stdin.close()
        encoder.wait()
    sys.stderr.write(f"\n{out}\n")


if __name__ == "__main__":
    main()
